# ============================================================
# MCinfraTI · Radar Security — ambiente de produção (VPS)
# Copie para .env e preencha todos os valores marcados como OBRIGATÓRIOS.
#   cp .env.example .env
# NUNCA commite o .env em repositórios.
# By: m3ss14s A L M Todos os direitos reservados - despoiled apenas e unicamente para CSI2 9/9/20-16h40

# ============================================================

# --- Obrigatório ---
# URL pública da aplicação (use https na VPS)
NEXTAUTH_URL=https://radar.seu-dominio.com.br

# Segredo de autenticação — gere com:  openssl rand -base64 32
NEXTAUTH_SECRET=

# Login do usuário administrador padrão
ADMIN_EMAIL=admin@seu-dominio.com.br
ADMIN_PASSWORD=

# Senha do banco de dados PostgreSQL
POSTGRES_PASSWORD=

# --- Opcional (valores padrão razoáveis) ---
POSTGRES_USER=radar
POSTGRES_DB=radar

# Porta HTTP da aplicação na VPS (padrão fixo: 8775). Coloque o proxy reverso aponando para ela.
# O app escuta só em 127.0.0.1. Mude apenas se 8775 já estiver em uso.
APP_PORT=8775

# Tag da imagem usada pelo docker compose (use para versionar/rollback)
VERSION=latest

# --- Fila assíncrona de scans (BullMQ + Redis) ---
# SCAN_ASYNC=true: /api/scan enfileira e o worker processa em segundo plano.
# Padrão false: scan síncrono (sem dependência de Redis). Mude para true apenas
# quando a stack redis+worker estiver rodando na VPS.
SCAN_ASYNC=false

# Conexão Redis (o docker compose injeta REDIS_HOST=redis/6379 automaticamente;
# estes valores valem para processos fora do compose, ex.: testes locais)
#By: m3ss14s A L M Todos os direitos reservados - despoiled apenas e unicamente para CSI2 9/9/20-16h40
REDIS_HOST=localhost
REDIS_PORT=6379
# --- OSINT / Username Tracker (Sherlock e Maigret via Docker) ---
# OSINT_ASYNC=true: o endpoint enfileira a busca e o serviço osint-worker executa
# os containers (Sherlock e/ou Maigret) com limites de recursos (Docker Engine API via socket).
OSINT_ASYNC=true

# Imagens usadas pelo osint-worker (sherlock e maigret como engines alternativas)
SHERLOCK_IMAGE=sherlock/sherlock:latest
MAIGRET_IMAGE=soxoj/maigret:latest

# Limites de recursos do container de busca
SHERLOCK_MEMORY=512m
SHERLOCK_CPUS=1.0

# Tempo máximo total da busca (wall-clock), em ms (padrão 15 min)
SHERLOCK_TIMEOUT_MS=900000

# Timeout por requisição de site (flag --timeout), em segundos
SHERLOCK_REQUEST_TIMEOUT=30

# --- OSINT / Domain Recon (theHarvester via Docker) ---
# Imagem oficial no GHCR (o CLI exige override de entrypoint para /opt/venv/bin/theHarvester).
HARVESTER_IMAGE=ghcr.io/laramies/theharvester:latest
# Limites de recursos do container (theHarvester embute Python; screenshots exigem mais)
HARVESTER_MEMORY=1g
HARVESTER_CPUS=1.0
# Tempo máximo total do recon (wall-clock), em ms (padrão 15 min)
HARVESTER_TIMEOUT_MS=900000

# --- Integração de API do theHarvester (fontes keyed) ---
# HARVESTER_API_ENABLED=true habilita fontes que exigem chave de API. As chaves
# são cadastradas pela interface (Domain Recon → "Integração de API") e ficam
# cifradas (AES-256-GCM) no banco. Padrão false: roda só com fontes keyless.
HARVESTER_API_ENABLED=false

# Segredo usado para cifrar/decifrar as chaves no banco. Precisa ser IGUAL nos
# serviços radar e osint-worker. Se vazio, é usado o NEXTAUTH_SECRET.
# Gere com:  openssl rand -base64 32
HARVESTER_KEYS_SECRET=
